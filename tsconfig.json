{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "strictPropertyInitialization": false,
    "target": "ES2023",
    "sourceMap": true,
    "rootDir": "./",
    "outDir": "./dist",
    "types": [
      "node",
      "jest"
    ],
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@app/contracts": [
        "./libs/contracts/src"
      ],
      "@app/contracts/*": [
        "./libs/contracts/src/*"
      ],
      "@app/database": [
        "./libs/database/src"
      ],
      "@app/database/*": [
        "./libs/database/src/*"
      ],
      "@app/messaging": [
        "./libs/messaging/src"
      ],
      "@app/messaging/*": [
        "./libs/messaging/src/*"
      ]
    }
  }
}